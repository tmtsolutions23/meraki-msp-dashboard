# Meraki API Configuration
# Get your API key from: Dashboard > My Profile > API access
MERAKI_API_KEY=your_meraki_api_key_here

# Optional: Override the base URL (default is the Meraki cloud API)
# MERAKI_BASE_URL=https://api.meraki.com/api/v1

# Dashboard Authentication
# Set a shared 6-digit PIN for dashboard access
DASHBOARD_PASSWORD=your_6_digit_pin_here

# Secret key for signing session cookies (generate with: openssl rand -hex 32)
DASHBOARD_SECRET=your_random_secret_here

# Meraki Webhook Secret
# Set this to the same shared secret configured in your Meraki dashboard webhook settings
MERAKI_WEBHOOK_SECRET=your_webhook_shared_secret_here

# Quoter (ScalePad) API — for generating replacement quotes
# Get credentials from Quoter: Account > API Keys
QUOTER_CLIENT_ID=your_quoter_client_id_here
QUOTER_CLIENT_SECRET=your_quoter_client_secret_here
